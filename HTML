<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Robbie Horror Picture Show — Preview</title>
  <script>document.documentElement.classList.add("js");</script>
  <meta name="description" content="Robbie Horror Picture Show — the best of the worst.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#0a0a09;
      --paper:#eee8dc;
      --red:#ef2f2f;
      --red2:#ff4640;
      --acid:#ffd23f;
      --muted:#b7b2a8;
      --line:rgba(255,255,255,.18);
      --max:1220px;
      --radius:22px;
      --ease-out:cubic-bezier(.2,.75,.25,1);
      --ease-spring:cubic-bezier(.2,.9,.25,1.15);
      --scroll-progress:0%;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:92px;background:var(--ink)}
    body{
      margin:0;
      color:var(--paper);
      background:
        radial-gradient(circle at 75% 12%, rgba(126,25,25,.18), transparent 30%),
        radial-gradient(circle at 14% 55%, rgba(73,122,95,.09), transparent 32%),
        var(--ink);
      font-family:"Instrument Sans", Arial, sans-serif;
      font-size:18px;
      line-height:1.55;
      overflow-x:hidden;
      --hero-shift:0px;
      --booking-shift:0px;
    }
    body:before{
      content:"";position:fixed;inset:0;pointer-events:none;z-index:999;
      opacity:.12;mix-blend-mode:screen;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.46'/%3E%3C/svg%3E");
    }
    body:after{
      content:"";position:fixed;left:0;top:0;width:var(--scroll-progress);height:3px;z-index:1000;pointer-events:none;
      background:linear-gradient(90deg,var(--red2),var(--acid));box-shadow:0 0 14px rgba(255,210,63,.28);
      transition:width .08s linear;
    }
    a{color:inherit}
    img{max-width:100%;display:block}
    .wrap{width:min(calc(100% - 40px),var(--max));margin-inline:auto}
    .eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.74rem;font-weight:700;color:var(--acid)}
    .section{padding:110px 0;position:relative}
    .rule{height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent)}

    .site-header{
      position:fixed;top:0;left:0;right:0;z-index:50;padding:22px 0;
      transition:padding .35s var(--ease-out),background .35s ease,border-color .35s ease,box-shadow .35s ease,backdrop-filter .35s ease;
      border-bottom:1px solid transparent;
    }
    .site-header.is-scrolled{
      padding:13px 0;background:rgba(10,10,9,.78);border-bottom-color:rgba(255,255,255,.08);
      backdrop-filter:blur(18px) saturate(1.15);box-shadow:0 12px 40px rgba(0,0,0,.16);
    }
    .site-header .inner{display:flex;align-items:center;justify-content:space-between;gap:20px}
    .brand{font-family:"Creepster","Arial Black",sans-serif;font-size:1.35rem;letter-spacing:.02em;color:var(--red2);text-decoration:none;text-shadow:0 2px 0 #000;transition:transform .28s var(--ease-spring),color .28s ease}
    .brand:hover{transform:rotate(-1.5deg) scale(1.025);color:#ff625d}
    .nav{display:flex;gap:12px;align-items:center}
    .nav a{font-size:.78rem;letter-spacing:.11em;text-transform:uppercase;text-decoration:none;font-weight:700;position:relative;transition:color .25s ease,opacity .25s ease,transform .25s var(--ease-out)}
    .nav a:not(.book):after{content:"";position:absolute;left:0;right:.11em;bottom:-6px;height:2px;background:var(--acid);transform:scaleX(0);transform-origin:right;transition:transform .28s var(--ease-out)}
    .nav a:not(.book):hover:after,.nav a[aria-current="true"]:after{transform:scaleX(1);transform-origin:left}
    .nav a:not(.book):hover{color:#fff;transform:translateY(-1px)}
    .nav .book{border:1px solid rgba(255,255,255,.55);padding:10px 15px;border-radius:999px;background:rgba(0,0,0,.25);backdrop-filter:blur(8px)}
    .nav .book:hover,.nav .book[aria-current="true"]{background:var(--red);border-color:var(--red);transform:translateY(-2px);box-shadow:0 10px 24px rgba(239,47,47,.18)}

    .hero{
      min-height:94svh;display:grid;align-items:end;position:relative;overflow:hidden;
      background:#0b0b0b;
    }
    .hero-media{position:absolute;inset:0}
    .hero-media img{width:100%;height:100%;object-fit:cover;object-position:center 29%;filter:saturate(.88) contrast(1.02) brightness(.9);transform:translate3d(0,var(--hero-shift),0) scale(1.045);will-change:transform}
    .hero-media:after{content:"";position:absolute;inset:0;background:
      linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.78) 38%,rgba(0,0,0,.12) 75%),
      linear-gradient(0deg,#0a0a09 0%,rgba(10,10,9,.15) 40%,rgba(0,0,0,.22) 100%);
    }
    .hero:before{content:"";position:absolute;inset:auto -10% 10% auto;width:65vw;height:65vw;border:0px solid rgba(239,47,47,.22);border-radius:50%;transform:rotate(-12deg);z-index:1;animation:slow-orbit 14s ease-in-out infinite alternate;transform-origin:center}
    .hero-copy{position:relative;z-index:2;padding:0px 0 78px;max-width:100%}
    .js .hero-copy > *{opacity:0;transform:translateY(24px);animation:hero-in .78s var(--ease-out) forwards}
    .js .hero-copy > *:nth-child(1){animation-delay:.12s}
    .js .hero-copy > *:nth-child(2){animation-delay:.22s}
    .js .hero-copy > *:nth-child(3){animation-delay:.34s}
    .js .hero-copy > *:nth-child(4){animation-delay:.46s}
    .js .hero-copy > *:nth-child(5){animation-delay:.58s}
    .hero-kicker{font-weight:700;text-transform:uppercase;letter-spacing:.18em;font-size:.76rem;margin-bottom:18px;color:var(--acid)}
    h1,h2,h3{margin:0;font-family:"Creepster","Arial Black",sans-serif;font-weight:400;line-height:.91;letter-spacing:.01em;text-align:left}
    h1{font-size:clamp(4.6rem,10vw,8.4rem);max-width:100%;color:var(--red2);text-shadow:0 5px 0 rgba(0,0,0,.85),0 0 26px rgba(239,47,47,.1)}
    .hero-sub{font-family:"Creepster","Arial Black",sans-serif;font-size:clamp(1.55rem,3vw,2.7rem);margin-top:12px;color:var(--paper);transform:rotate(-1.2deg);display:inline-block}
    .hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:38px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 22px;border-radius:999px;text-decoration:none;text-transform:uppercase;letter-spacing:.09em;font-weight:800;font-size:.78rem;transition:transform .28s var(--ease-spring),background .25s ease,border-color .25s ease,box-shadow .28s var(--ease-spring);position:relative;overflow:hidden;isolation:isolate}
    .btn:before{content:"";position:absolute;inset:-2px auto -2px -35%;width:28%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-18deg) translateX(-240%);transition:transform .65s var(--ease-out);z-index:-1}
    .btn:hover:before{transform:skewX(-18deg) translateX(620%)}
    .btn span{display:inline-block;transition:transform .28s var(--ease-spring)}
    .btn:hover span{transform:translate(3px,-2px)}
    .btn-primary{background:var(--paper);color:#111;border:0px solid var(--acid);box-shadow:4px 4px 0 var(--red)}
    .btn-primary:hover{transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--red)}
    .btn-secondary{border:1px solid rgba(255,255,255,.7);background:rgba(10,10,10,.35);backdrop-filter:blur(6px)}
    .btn-secondary:hover{background:var(--red);border-color:var(--red)}
    .hero-note{margin-top:50px;display:flex;align-items:center;gap:16px;color:#c9c3b8;font-size:.82rem;text-transform:uppercase;letter-spacing:.1em}
    .hero-note:before{content:"";width:62px;height:1px;background:rgba(255,255,255,.45)}

    .intro{padding-top:120px;padding-bottom:105px;text-align:center}
    .intro .copy{width:min(800px,100%);margin:0 auto}
    .intro h2{font-size:clamp(3.2rem,7vw,6.2rem);color:var(--acid);margin-bottom:34px;transform:rotate(.5deg)}
    .intro p{font-size:clamp(1.2rem,2.1vw,1.75rem);line-height:1.45;color:#e5ded2;margin:0}
    .intro p em{color:var(--red2);font-style:normal;font-weight:700}
    .intro p a{color:var(--paper);text-decoration-thickness:2px;text-underline-offset:4px;text-decoration-color:var(--red2);transition:text-decoration-color .25s ease,color .25s ease}
    .intro p a:hover{color:var(--red2);text-decoration-color:currentColor}
    .vhs{width:190px;margin:58px auto 0;filter:drop-shadow(5px 7px 0 rgba(239,47,47,.35));transform:rotate(-3deg);transition:transform .5s var(--ease-spring),filter .5s ease}
    .vhs:hover{transform:rotate(2deg) translateY(-5px) scale(1.025);filter:drop-shadow(8px 11px 0 rgba(239,47,47,.42))}
    .vhs svg{width:100%;height:auto}

    .gallery-section{padding:32px 0 100px}
    .gallery-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:34px}
    .gallery-head h2{font-size:clamp(3.1rem,6vw,5.6rem);color:var(--red2)}
    .gallery-head p{max-width:430px;color:var(--muted);margin:0 0 8px;font-size:1rem}
    .gallery-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:92px;gap:12px}
    .gallery-grid figure{margin:0;overflow:hidden;border-radius:18px;position:relative;background:#151515;border:1px solid rgba(255,255,255,.08);transition:transform .45s var(--ease-out),border-color .35s ease,box-shadow .45s ease}
    .gallery-grid figure:hover{transform:translateY(-5px);border-color:rgba(255,210,63,.2);box-shadow:0 24px 60px rgba(0,0,0,.28)}
    .gallery-grid img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease,filter .5s ease;filter:saturate(.9) contrast(1.03)}
    .gallery-grid figure:hover img{transform:scale(1.035);filter:saturate(1.08)}
    .gallery-grid figure:nth-child(1){grid-column:1/7;grid-row:span 5}
    .gallery-grid figure:nth-child(2){grid-column:7/10;grid-row:span 6}
    .gallery-grid figure:nth-child(3){grid-column:10/13;grid-row:span 3}
    .gallery-grid figure:nth-child(4){grid-column:10/13;grid-row:span 3}
    .gallery-grid figure:nth-child(5){grid-column:1/4;grid-row:span 4}
    .gallery-grid figure:nth-child(6){grid-column:4/9;grid-row:span 4}
    .gallery-grid figure:nth-child(7){grid-column:9/13;grid-row:span 4}
    .gallery-grid figure:after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);pointer-events:none}

    .agenda{background:var(--paper);color:#101010;isolation:isolate}
    .agenda:before{content:"";position:absolute;top:-28px;left:0;width:100%;height:58px;background:var(--paper);clip-path:polygon(0 42%,7% 22%,12% 57%,19% 28%,28% 60%,35% 32%,45% 63%,56% 30%,66% 55%,73% 33%,82% 65%,90% 30%,100% 52%,100% 100%,0 100%)}
    .agenda-top{display:flex;justify-content:space-between;align-items:end;gap:26px;margin-bottom:42px}
    .agenda h2{font-size:clamp(3.8rem,7vw,6.8rem);color:var(--red);max-width:720px}
    .agenda-top .eyebrow{color:#111}
    .agenda-top p{max-width:430px;color:#555;margin:0 0 12px}
    .event-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .event-card{background:#0d0d0c;color:var(--paper);min-height:360px;border-radius:20px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.04);transition:transform .38s var(--ease-spring),box-shadow .38s ease,border-color .38s ease}
    .event-card:hover{transform:translateY(-7px) rotate(-.25deg);box-shadow:0 24px 55px rgba(29,14,10,.18);border-color:rgba(239,47,47,.28)}
    .event-card:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 16px,rgba(255,255,255,.025) 16px 17px);pointer-events:none}
    .event-no{font-family:"Creepster","Arial Black",sans-serif;font-size:2.8rem;color:var(--red2)}
    .event-date{font-family:"Creepster","Arial Black",sans-serif;font-size:clamp(3.2rem,5vw,4.5rem);line-height:.9;color:var(--acid);margin:20px 0 10px}
    .event-meta{color:#c4beb5;font-size:.9rem;text-transform:uppercase;letter-spacing:.07em}
    .event-film{font-weight:700;font-size:1.1rem;margin-top:4px;color:white}
    .slot{margin-top:34px;border-top:1px solid rgba(255,255,255,.18);padding-top:16px;display:flex;justify-content:space-between;gap:14px;font-size:.74rem;text-transform:uppercase;letter-spacing:.1em;color:#b8b2aa}

    .booking{padding:120px 0 125px;position:relative;overflow:hidden}
    .booking-media{position:absolute;inset:0;opacity:.46}
    .booking-media img{width:100%;height:100%;object-fit:cover;object-position:center 54%;filter:saturate(.75) contrast(1.12);transform:translate3d(0,var(--booking-shift),0) scale(1.06);will-change:transform}
    .booking:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,6,6,.97) 0%,rgba(6,6,6,.82) 48%,rgba(6,6,6,.52) 100%),linear-gradient(0deg,#0a0a09 0%,transparent 45%,#0a0a09 100%)}
    .booking-inner{position:relative;z-index:2;max-width:100%}
    .booking h2{font-size:clamp(4rem,8vw,7.8rem);color:var(--red2);margin:10px 0 25px}
    .booking p{font-size:clamp(1.15rem,2vw,1.5rem);max-width:650px;color:#ddd6cc;margin:0 0 30px}
    .booking .small{font-size:.78rem;color:#9e9890;margin-top:18px;text-transform:uppercase;letter-spacing:.08em}

    footer{padding:28px 0 42px;color:#777168;font-size:.75rem;text-transform:uppercase;letter-spacing:.09em}
    footer .inner{display:flex;justify-content:space-between;gap:20px;border-top:1px solid rgba(255,255,255,.1);padding-top:24px}


    /* Motion system: scroll-triggered reveals stay subtle and progressive-enhancement friendly. */
    .js .reveal{opacity:0;transform:translate3d(0,38px,0);filter:blur(5px);transition:opacity .75s var(--ease-out),transform .8s var(--ease-out),filter .7s ease;transition-delay:var(--delay,0ms);will-change:opacity,transform,filter}
    .js .reveal.reveal-soft{transform:translate3d(0,24px,0) scale(.985)}
    .js .reveal.reveal-left{transform:translate3d(-34px,0,0)}
    .js .reveal.is-visible{opacity:1;transform:translate3d(0,0,0) scale(1);filter:blur(0)}
    .js .reveal.reveal-complete{transition-delay:0ms;will-change:auto}
    .js .gallery-grid figure.reveal.reveal-complete{transition:transform .45s var(--ease-out),border-color .35s ease,box-shadow .45s ease}
    .js .event-card.reveal.reveal-complete{transition:transform .38s var(--ease-spring),box-shadow .38s ease,border-color .38s ease}
    .js .vhs.reveal.reveal-complete{transition:transform .5s var(--ease-spring),filter .5s ease}

    @keyframes hero-in{to{opacity:1;transform:translateY(0)}}
    @keyframes slow-orbit{from{transform:rotate(-12deg) scale(.98)}to{transform:rotate(-6deg) scale(1.035)}}

    @media (max-width: 900px){
      body{font-size:17px}
      .nav a:not(.book){display:none}
      .hero{min-height:860px}
      .hero-media img{object-position:62% 26%}
      .hero-media:after{background:linear-gradient(0deg,#0a0a09 0%,rgba(0,0,0,.6) 50%,rgba(0,0,0,.25) 100%),linear-gradient(90deg,rgba(0,0,0,.78),transparent)}
      .hero-copy{padding-bottom:58px;padding-top:150px}
      h1{font-size:clamp(4rem,16vw,6.2rem)}
      .gallery-head,.agenda-top{display:block}
      .gallery-head p,.agenda-top p{margin-top:18px}
      .gallery-grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:210px}
      .gallery-grid figure:nth-child(n){grid-column:auto;grid-row:auto}
      .gallery-grid figure:nth-child(1),.gallery-grid figure:nth-child(6){grid-column:span 2}
      .event-grid{grid-template-columns:1fr}
      .event-card{min-height:300px}
    }
    @media (max-width: 560px){
      .wrap{width:min(calc(100% - 26px),var(--max))}
      .site-header{padding-top:16px}
      .brand{font-size:1.12rem;max-width:170px;line-height:.9}
      .nav .book{font-size:.68rem;padding:9px 12px}
      .section{padding:86px 0}
      .hero{min-height:760px}
      .hero-copy{padding-top:130px;padding-bottom:50px}
      h1{font-size:clamp(3.55rem,18vw,5.3rem)}
      .hero-sub{font-size:1.7rem}
      .hero-actions{gap:10px}.btn{width:100%}
      .intro{padding-top:94px}.intro h2{font-size:3.45rem}
      .intro p{font-size:1.12rem}
      .gallery-grid{grid-auto-rows:160px;gap:8px}
      .gallery-grid figure:nth-child(1),.gallery-grid figure:nth-child(6){grid-column:span 2}
      .booking h2{font-size:4.2rem}
      footer .inner{display:block}footer .inner div+div{margin-top:8px}
    }

    @media (prefers-reduced-motion: reduce){
      html{scroll-behavior:auto}
      body:after{transition:none}
      .hero:before{animation:none}
      .hero-media img,.booking-media img{transform:scale(1.02)}
      .js .hero-copy > *{opacity:1;transform:none;animation:none}
      .js .reveal,.js .reveal.reveal-soft,.js .reveal.reveal-left{opacity:1;transform:none;filter:none;transition:none}
      .btn,.btn:before,.btn span,.brand,.gallery-grid figure,.gallery-grid img,.event-card,.vhs{transition:none}
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="wrap inner">
      <a class="brand" href="#top">Robbie Horror Picture Show</a>
      <nav class="nav" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#gallery">Gallery</a>
        <a href="#agenda">Agenda</a>
        <a class="book" href="#booking">Book me</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-media"><img src="assets/robbie-8.webp" alt="Robbie Horror presenting the show on stage"></div>
      <div class="wrap hero-copy">
        <div class="hero-kicker">Lowbrow cinema · live preshow · glorious trash</div>
        <h1 id="hero-title">Robbie Horror<br>Picture Show</h1>
        <div class="hero-sub">The best of the worst b-movies screening.</div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#agenda">Event agenda <span aria-hidden="true">↓</span></a>
          <a class="btn btn-secondary" href="#booking">Book me <span aria-hidden="true">↗</span></a>
        </div>  
      </div>
    </section>

    <section class="intro" id="about">
      <div class="wrap copy">
        <div class="eyebrow reveal" style="--delay:0ms"></div>
        <h2 class="reveal reveal-soft" style="--delay:80ms; text-align: center;">Ain't no regular movie night.</h2>
        <p class="reveal reveal-soft" style="--delay:150ms">Peoples! Are you ready for the most deranged, absurd and totally camp b-movie extravaganza. The Robbie Horror Picture Show ain’t no regular movie night and don’t be expecting any high quality plots and storylines, no. Expect the best of the worst and some lowbrow entertainment, hosted by <a href="https://maddaddys.nl/" target="_blank" rel="noopener">Robbie Horror</a>, also known as the Maddest Barber in the region.</p>
        <div class="vhs reveal reveal-soft" style="--delay:220ms" aria-label="VHS tape icon">
          <?xml version="1.0" encoding="UTF-8"?>
<svg id="RobTshirt_xA0_Image" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 385.4 399.4">
