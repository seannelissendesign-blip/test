  <script>
    (() => {
      const root = document.documentElement;
      const body = document.body;
      const header = document.querySelector('.site-header');
      const hero = document.querySelector('.hero');
      const booking = document.querySelector('.booking');
      const revealItems = document.querySelectorAll('.reveal');
      const navLinks = [...document.querySelectorAll('.nav a[href^="#"]')];
      const sections = navLinks
        .map(link => document.querySelector(link.getAttribute('href')))
        .filter(Boolean);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if ('IntersectionObserver' in window && !reduceMotion) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            entry.target.addEventListener('transitionend', event => {
              if (event.propertyName === 'opacity') entry.target.classList.add('reveal-complete');
            }, { once: true });
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.13, rootMargin: '0px 0px -7% 0px' });
        revealItems.forEach(item => revealObserver.observe(item));
      } else {
        revealItems.forEach(item => item.classList.add('is-visible'));
      }

      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            navLinks.forEach(link => {
              const active = link.getAttribute('href') === `#${entry.target.id}`;
              if (active) link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            });
          });
        }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
        sections.forEach(section => sectionObserver.observe(section));
      }

      let ticking = false;
      const updateScrollEffects = () => {
        const y = window.scrollY || window.pageYOffset;
        const max = Math.max(1, root.scrollHeight - window.innerHeight);
        body.style.setProperty('--scroll-progress', `${Math.min(100, (y / max) * 100)}%`);
        header?.classList.toggle('is-scrolled', y > 24);

        if (!reduceMotion) {
          if (hero) {
            const heroRect = hero.getBoundingClientRect();
            if (heroRect.bottom > 0) body.style.setProperty('--hero-shift', `${Math.min(55, y * 0.055)}px`);
          }
          if (booking) {
            const rect = booking.getBoundingClientRect();
            const centerOffset = rect.top + rect.height / 2 - window.innerHeight / 2;
            const shift = Math.max(-28, Math.min(28, -centerOffset * 0.025));
            body.style.setProperty('--booking-shift', `${shift}px`);
          }
        }
        ticking = false;
      };

      const requestScrollUpdate = () => {
        if (!ticking) {
          requestAnimationFrame(updateScrollEffects);
          ticking = true;
        }
      };

      updateScrollEffects();
      addEventListener('scroll', requestScrollUpdate, { passive: true });
      addEventListener('resize', requestScrollUpdate, { passive: true });
    })();
  </script>
